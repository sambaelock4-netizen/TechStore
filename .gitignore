# ==================================================================================
# TECHSTORE — Configuration des Exclusions Git (.gitignore)
# ==================================================================================
# Fichiers et dossiers ignorés pour la propreté du dépôt :
# 1. Dépendances et environnement.
# 2. Fichiers spécifiques à l'IDE et à l'OS.
# 3. Logs et fichiers temporaires.
# 4. Uploads utilisateurs (sauf .gitkeep).
# ==================================================================================

# Dependencies
/vendor/
/node_modules/

# Environment
/.env
/.env.local
/.env.*.local

# IDE
/.idea/
/.vscode/
*.swp
*.swo

# OS
/.DS_Store
/Thumbs.db

# Logs
/logs/
*.log

# Uploads (user files)
# Uploads (user files)
/public/uploads/*
!/public/uploads/.gitkeep

# Database (optional - keep SQL files but not db data)
/*.sqlite
/*.db

# Composer
/composer.phar

# NPM
/npm-debug.log
/yarn-error.log
