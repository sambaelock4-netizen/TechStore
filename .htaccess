# ==================================================================================
# TECHSTORE — Configuration Serveur Apache (.htaccess)
# ==================================================================================
# Ce fichier gère :
# 1. La réécriture d'URL pour le Front Controller (router.php).
# 2. La redirection automatique vers index.php si nécessaire.
# 3. La sécurité de base (interdiction du listage de répertoire).
# ==================================================================================

# Activation de la réécriture d'URL
RewriteEngine On
RewriteBase /TechStore/

# Set the default index file
DirectoryIndex index.php splash.php

# Handle root URL - redirect to splash
RewriteRule ^$ splash.php [L]

# Allow direct access to splash files
RewriteRule ^splash\.php$ - [L]
RewriteRule ^admin_splash\.php$ - [L]
RewriteRule ^router\.php$ - [L]

# Route all requests through router.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ router.php?url=$1 [L,QSA]
